# Plantilla de variables de entorno de CLIMEGREEN
# Copia este archivo a .env (el .gitignore lo excluye) y ajusta los valores.

# Ruta del dataset histórico (relativa a la raíz del proyecto)
CLIMEGREEN_DATA_PATH=data/clima_historico.json

# Ruta del archivo de logs
CLIMEGREEN_LOG_PATH=logs/climegreen.log
